{
  "_填写说明": "本文件为公共配置，一般用管理台改：python bot.py 启动后访问 http://127.0.0.1:8008（或双击 管理台.bat）。密钥一律放在 .env（已 gitignore），不要写进本文件。",
  "platform": "qq",
  "deepseek_api_key": "",
  "deepseek_base_url": "https://api.deepseek.com",
  "model": "deepseek-v4-flash",
  "bot_name": "",
  "user_names": "",
  "character_card": "",
  "temperature": 0.8,
  "timeout_seconds": 180,
  "max_history_turns": 20,
  "max_reply_tokens": 2000,
  "admin": {
    "enable": true,
    "port": 8008,
    "open_browser": false
  },
  "reply": {
    "mode": "medium",
    "presets": {
      "short": {
        "max_chars": 300
      },
      "medium": {
        "max_chars": 900
      },
      "long": {
        "max_chars": 2000
      }
    }
  },
  "max_context_chars": 20000,
  "max_history_chars": 0,
  "keep_recent_full": 6,
  "summary_max_chars": 2000,
  "message_chunk_chars": 2000,
  "typing_indicator": true,
  "allow_all": false,
  "persona_dir": "prompt",
  "persona_file": "",
  "system_prompt": "你是一个角色扮演助手，严格遵循角色卡与世界书的设定进行回应。",
  "worldbook": {
    "dir": "book",
    "files": [],
    "base_mode": "constant",
    "base_max_chars": 1500,
    "emphasis_max_chars": 1500,
    "match_context": false,
    "match_context_turns": 4,
    "synonyms": {},
    "deny_keys": [
      "调试",
      "渲染"
    ]
  },
  "sleep": {
    "keywords": [],
    "auto_threshold_turns": 10,
    "jump_to_night": true,
    "max_important": 100,
    "max_output_tokens": 1000,
    "chunk_size": 40
  },
  "identity": {
    "map_path": "data/identity_map.json",
    "owner_name": "主人",
    "dream_name": "",
    "reserved_names": [
      "主人"
    ],
    "protect_names": [],
    "undeclared_reply": "【请先告诉机器人你是谁～发【我是xxx】就行】",
    "unknown_instruction_reply": "【不认识这个指令哦～】"
  },
  "non_owner_rule_file": "",
  "time": {
    "path": "data/time/clock.json",
    "enable": true,
    "undo_size": 10
  },
  "plugins": {
    "memory": true,
    "chatlog": true,
    "vault_sync": true,
    "proactive": false,
    "worldbook": true
  },
  "recall": {
    "enable": true,
    "rumination_prob": 0,
    "consistent_top": 2
  },
  "memory": {
    "backend": "auto",
    "db_path": "data/memory.db",
    "persistent_importance": 9,
    "persistent_max": 3,
    "vector": {
      "enable": true,
      "model": "BAAI/bge-small-zh-v1.5",
      "top_k": 3,
      "min_score": 0.3,
      "trigger_min_score": 0.46
    },
    "tencentdb": {
      "enabled": false,
      "endpoint": "http://127.0.0.1:8420",
      "api_key": "",
      "service_id": "default",
      "team_id": "deepdiscord",
      "agent_id": "luotavern",
      "session_prefix": "rp",
      "api_version": "v3",
      "timeout_seconds": 10,
      "recall_timeout_seconds": 2.5,
      "enable_recall": true,
      "sync_chatlog": true
    }
  },
  "llm_provider": "deepseek",
  "llm_providers": {},
  "status_bar": {
    "enable": true,
    "repair": true,
    "inherit_card": true,
    "fields": [
      "时间",
      "地点",
      "表情",
      "姿态",
      "服装",
      "身体反应",
      "内心"
